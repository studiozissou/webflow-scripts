      "parameters": {
        "jsCode": "// Base64-encode the PDFShift binary so MailerSend can attach it.\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n  out.push({ json: { ...items[i].json, pdfBase64: buf.toString('base64') } });\n}\nreturn out;"
