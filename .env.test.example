# Copy to `.env.test` (gitignored) and fill in the secrets.
#
# Without this file every test in tests/acceptance/nem-test-phase-b.spec.js skips —
# 49 tests, including all Tier 1 coverage. The non-secret values below are already
# correct; only the four secrets need filling.

# ---------------------------------------------------------------------------
# Tier 1 — browser tests. STAGING_URL alone unlocks most of the 49.
# ---------------------------------------------------------------------------

# The spec already defaults to this, so it is optional. Set it to point at a
# different environment (e.g. production once nemmatters.com is live).
STAGING_URL=https://nem-life-1.webflow.io

# ---------------------------------------------------------------------------
# Tier 1 — tests that submit the form for real.
# ---------------------------------------------------------------------------
# Gates the Screen 6 confirmation + correction-flow tests. Live and verified.
# NOTE: /submit rate-limits to 3 per IP per hour; the 4th returns
# {"status":"rate_limited"}. A full test run can trip this.
NEM_SUBMIT_WEBHOOK_URL=https://reus.app.n8n.cloud/webhook/nem-submit
NEM_VERIFY_WEBHOOK_URL=https://reus.app.n8n.cloud/webhook/nem-verify

# ---------------------------------------------------------------------------
# Tier 3 — E2E email tests, tagged @e2e-email. Optional; they skip without these.
# ---------------------------------------------------------------------------

# MailerSend — the CLIENT's token, scope "Sending access".
# ⚠️ The account is still on a TRIAL plan: sends to any recipient MailerSend has
# not already delivered to return 422 (#MS42225). E2E delivery assertions will
# fail for that reason alone until Alex upgrades — see the P0 queue item
# `nem-mailersend-trial-account-blocks-report-delivery`.
MAILERSEND_API_KEY=

# Gmail API — reads the test inbox to confirm the verification email and the
# report PDF actually arrive. Tests use plus-aliases for isolation:
#   will+nem-test-{timestamp}@teamzissou.io
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
