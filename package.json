{
  "name": "webflow-scripts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Frozen custom JS and CSS for a few Webflow sites, served by jsDelivr",
  "scripts": {
    "test:rhp": "node --test 'tests/rhp/*.test.js'",
    "test:tsc": "node --test 'tests/tsc/*.test.js'",
    "test:jayshetty": "node --test 'tests/jayshetty/*.test.js'",
    "test:acceptance": "playwright test --config=tests/acceptance/playwright.config.js",
    "test": "npm run test:rhp && npm run test:tsc && npm run test:jayshetty"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "dotenv": "^17.3.1",
    "playwright": "^1.50.0"
  }
}
