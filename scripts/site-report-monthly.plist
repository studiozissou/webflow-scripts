<?xml version="1.0" encoding="UTF-8"?>
<!--
  Monthly goal-report drafts. Runs scripts/site-report-monthly.sh on day 3 of every month at
  07:00 local time (Google profile figures lag about 2 days); if the Mac is asleep then,
  launchd runs it on wake. It drafts each report as a private Notion page, queues one review
  task per client, and sends nothing to a client.
  To pause it without uninstalling:
    touch ~/webflow-internal/site-report/site-report.off

  NOT INSTALLED BY DEFAULT. Install:
    cp scripts/site-report-monthly.plist ~/Library/LaunchAgents/io.teamzissou.site-report-monthly.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/io.teamzissou.site-report-monthly.plist

  Run it once now:
    launchctl kickstart gui/$(id -u)/io.teamzissou.site-report-monthly

  Uninstall:
    launchctl bootout gui/$(id -u)/io.teamzissou.site-report-monthly
    rm ~/Library/LaunchAgents/io.teamzissou.site-report-monthly.plist

  Output and errors go to ~/Library/Logs/site-report-monthly.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.teamzissou.site-report-monthly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/willmorley/webflow-scripts/scripts/site-report-monthly.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin</string>
        <key>SITE_REPORT_REPO</key>
        <string>/Users/willmorley/webflow-scripts</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>3</integer>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/willmorley/Library/Logs/site-report-monthly.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/willmorley/Library/Logs/site-report-monthly.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
